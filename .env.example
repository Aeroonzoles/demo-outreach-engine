# Copy to .env and fill in. NEVER commit .env.
DRY_RUN=true            # keep true until you've reviewed drafts and checked the rules
DAILY_CAP=20
REVIEW_FIRST_N=20       # emails you must approve by hand before auto-approval starts
SENDER_NAME=Your Name
SENDER_EMAIL=you@yourdomain.com
SENDER_ADDRESS=Your postal address, Bengaluru
SENDER_TAGLINE=web developer
SENDER_CITY=Bengaluru
DEMO_BASE_URL=https://demos.yourdomain.com
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
